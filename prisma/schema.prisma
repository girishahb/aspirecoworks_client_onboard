// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  CLIENT
  ADMIN
  MANAGER
  USER
  AGGREGATOR
  FINANCE
  STAFF
  RECEPTION
}

enum OnboardingStage {
  ADMIN_CREATED
  PAYMENT_PENDING
  PENDING_DOCUMENTS
  DOCUMENTS_SUBMITTED
  UNDER_REVIEW
  PAYMENT_CONFIRMED
  KYC_IN_PROGRESS
  KYC_REVIEW
  AGREEMENT_DRAFT_SHARED
  SIGNED_AGREEMENT_RECEIVED
  FINAL_AGREEMENT_SHARED
  ACTIVE
  COMPLETED
  REJECTED
}

enum DocumentStatus {
  PENDING
  UPLOADED
  REVIEW_PENDING
  PENDING_WITH_CLIENT
  PENDING_WITH_ADMIN
  APPROVED
  VERIFIED
  REJECTED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

enum DocumentType {
  AADHAAR
  PAN
  KYC
  CONTRACT
  LICENSE
  CERTIFICATE
  IDENTIFICATION
  FINANCIAL
  AGREEMENT_DRAFT
  AGREEMENT_SIGNED
  AGREEMENT_FINAL
  NOC_ASPIRE_COWORKS
  NOC_LANDLORD
  ELECTRICITY_BILL
  WIFI_BILL
  RECEIVED_MAIL
  OTHER
}

enum DocumentOwner {
  CLIENT
  ADMIN
}

enum RenewalStatus {
  ACTIVE
  EXPIRED
}

enum ClientChannel {
  DIRECT
  AGGREGATOR
}

enum OperationalStatus {
  ACTIVE
  INACTIVE
  PENDING
  UNKNOWN
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String?   // Nullable for invited clients who haven't set password yet
  firstName         String
  lastName          String
  role              UserRole  @default(USER)
  companyId         String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  // Invite flow for admin-created clients
  inviteToken       String?   @unique
  inviteTokenExpiry DateTime?
  isActivated       Boolean   @default(false) // True after set-password or legacy users
  // Forgot password flow
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  // Aggregator users: partner brand this user acts on behalf of. Populated when role = AGGREGATOR.
  aggregatorName    String?

  // Relations
  company          ClientProfile?            @relation("CompanyUsers", fields: [companyId], references: [id])
  createdClients   ClientProfile[]           @relation("CreatedBy")
  documents        Document[] // uploaded by this user
  ownedDocuments   Document[]                @relation("DocumentOwner")
  auditLogs        AuditLog[]
  authTokens       AuthToken[]
  invoiceProfile   AggregatorInvoiceProfile? // Only populated for AGGREGATOR role
  createdBookings  AggregatorBooking[]       @relation("BookingCreatedBy")
  contractHistoryChanges ClientContractHistory[] @relation("ContractHistoryChangedBy")
  visitorCheckIns        VisitorVisit[]          @relation("VisitorCheckedInBy")
  visitorCheckOuts       VisitorVisit[]          @relation("VisitorCheckedOutBy")
  homeLocationId         String?
  homeLocation           Location?               @relation("UserHomeLocation", fields: [homeLocationId], references: [id])
  assignedTickets        Ticket[]                @relation("TicketAssignee")
  closedTickets          Ticket[]                @relation("TicketClosedBy")
  ticketEvents           TicketEvent[]           @relation("TicketEventActor")
  ticketAttachments      TicketAttachment[]      @relation("TicketAttachmentUploader")
  defaultTicketRoutes    IssueGroupRoute[]       @relation("RouteDefaultAssignee")
  createdQrCodes         QrCode[]                @relation("QrCodeCreatedBy")

  @@index([homeLocationId])
  @@map("users")
}

model AuthToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model ClientProfile {
  id              String          @id @default(uuid())
  companyName     String
  contactEmail    String
  contactPhone    String?
  taxId           String?         @unique
  address         String?
  city            String?
  state           String?
  zipCode         String?
  country         String?
  onboardingStage OnboardingStage @default(ADMIN_CREATED)
  activationDate  DateTime?
  kycCompleted    Boolean         @default(false)
  renewalDate     DateTime?
  renewalStatus   RenewalStatus?
  // Channel attribution: DIRECT (default, existing) or AGGREGATOR (new track)
  clientChannel   ClientChannel   @default(DIRECT)
  aggregatorName  String?
  // Contract term for aggregator clients; mirrored to renewalDate for cron compatibility
  contractStartDate DateTime?
  contractEndDate   DateTime?
  notes           String?         @db.Text
  // Billing details for invoices
  gstNumber       String?
  billingName     String?
  billingAddress  String?
  // Excel / branch import fields
  locationId          String?
  vendorId            String?
  membershipType      String?
  officeType          String?           // e.g. Virtual
  leadSource          String?           // e.g. Aggregator, Direct
  contractMonths      Int?              // No of Months from Excel
  operationalStatus   OperationalStatus @default(UNKNOWN)
  contactPersonName   String?
  contactPersonTitle  String?
  contactPersonPhone  String?
  externalBookingId   String?           @unique
  legacyPaymentStatus String?
  legacyCharges       Float?
  lastContactedAt     DateTime?         @db.Date
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  createdBy          User                @relation("CreatedBy", fields: [createdById], references: [id])
  users              User[]              @relation("CompanyUsers")
  documents          Document[]
  payments           Payment[]
  invoices           Invoice[]
  auditLogs          AuditLog[]
  renewalReminders   RenewalReminder[]
  aggregatorBookings AggregatorBooking[]
  contractHistory    ClientContractHistory[]
  location           Location?           @relation(fields: [locationId], references: [id])
  vendor             Vendor?             @relation(fields: [vendorId], references: [id])

  @@index([createdById])
  @@index([createdAt])
  @@index([locationId])
  @@index([vendorId])
  @@index([operationalStatus])
  @@map("client_profiles")
}

/// Snapshot of a previous agreement term when start/end or booking ID is changed.
model ClientContractHistory {
  id                   String   @id @default(uuid())
  clientProfileId      String
  contractStartDate    DateTime?
  contractEndDate      DateTime?
  externalBookingId    String?
  note                 String?  @db.Text
  changedById          String
  changedAt            DateTime @default(now())

  clientProfile ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  changedBy     User          @relation("ContractHistoryChangedBy", fields: [changedById], references: [id])

  @@index([clientProfileId, changedAt])
  @@index([changedById])
  @@map("client_contract_history")
}

model Vendor {
  id          String   @id @default(uuid())
  name        String
  code        String
  sourceSheet String?
  locationId  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location Location?       @relation(fields: [locationId], references: [id])
  clients  ClientProfile[]

  @@unique([locationId, code])
  @@index([locationId])
  @@map("vendors")
}

/// Aggregator rate card (GST-exclusive). Keyed by vendor code so one card
/// applies across all location copies of the same aggregator.
model VendorRateCard {
  id                String   @id @default(uuid())
  vendorCode        String
  sourceCompanyName String?
  membershipType    String
  rateExclusive     Float
  currency          String   @default("INR")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([vendorCode, membershipType])
  @@index([vendorCode])
  @@map("vendor_rate_cards")
}

model RenewalReminder {
  id         String   @id @default(uuid())
  companyId  String
  daysBefore Int
  sentAt     DateTime @default(now())

  // Relations
  company ClientProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, daysBefore])
  @@index([companyId])
  @@index([sentAt])
  @@map("renewal_reminders")
}

model Document {
  id              String         @id @default(uuid())
  clientProfileId String
  uploadedById    String
  ownerId         String? // User who owns this document in the workflow (defaults to uploader)
  documentOwner   DocumentOwner  @default(CLIENT) // CLIENT or ADMIN (workflow owner)
  fileName        String
  fileKey         String         @unique
  documentType    DocumentType // KYC, CONTRACT, AGREEMENT_*, etc.
  fileSize        Int
  mimeType        String?
  status          DocumentStatus @default(PENDING)
  version         Int            @default(1) // Increments when replaced by a new upload
  replacesId      String? // Previous document this one replaces (keeps history)
  verifiedAt      DateTime?
  verifiedById    String?
  rejectionReason String?        @db.Text
  adminRemarks    String?        @db.Text
  reviewNotes     String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations (company = ClientProfile)
  clientProfile ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  uploadedBy    User          @relation(fields: [uploadedById], references: [id])
  owner         User?         @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  replaces      Document?     @relation("DocumentVersions", fields: [replacesId], references: [id], onDelete: SetNull)
  replacedBy    Document[]    @relation("DocumentVersions")
  auditLogs     AuditLog[]

  @@index([clientProfileId])
  @@index([uploadedById])
  @@index([ownerId])
  @@index([fileKey])
  @@index([documentType])
  @@index([replacesId])
  @@index([clientProfileId, documentType])
  @@map("documents")
}

model Payment {
  id                     String        @id @default(uuid())
  clientProfileId        String
  amount                 Float // Total payable (inclusive of GST when applicable)
  currency               String        @default("INR")
  status                 PaymentStatus @default(CREATED)
  provider               String // e.g. Razorpay
  providerPaymentId      String?
  razorpayPaymentLinkId  String? // plink_xxx - for webhook matching when payment.captured has no notes
  paymentLink            String?
  paidAt                 DateTime?
  // GST breakdown (null = legacy payment; amount is taxable base)
  taxableAmount          Float?
  gstMode                String? // NONE | CGST_SGST | IGST
  cgstRate               Float?
  sgstRate               Float?
  igstRate               Float?
  cgstAmount             Float?        @default(0)
  sgstAmount             Float?        @default(0)
  igstAmount             Float?        @default(0)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  // Relations (company = ClientProfile)
  clientProfile ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  invoices      Invoice[]

  @@index([clientProfileId])
  @@index([status])
  @@index([razorpayPaymentLinkId])
  @@map("payments")
}

model Invoice {
  id             String   @id @default(uuid())
  companyId      String
  paymentId      String
  invoiceNumber  String   @unique
  amount         Float // Base amount (before GST)
  gstAmount      Float
  totalAmount    Float // amount + gstAmount
  // Future-ready fields for CGST/SGST/IGST split
  cgstAmount     Float?   @default(0)
  sgstAmount     Float?   @default(0)
  igstAmount     Float?   @default(0)
  // Billing details
  gstNumber      String? // Client GST number
  billingName    String
  billingAddress String
  // PDF storage
  pdfUrl         String?
  pdfFileKey     String? // Storage key for PDF file
  createdAt      DateTime @default(now())

  // Relations
  company ClientProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payment Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([paymentId])
  @@index([invoiceNumber])
  @@index([createdAt])
  @@map("invoices")
}

model ComplianceRequirement {
  id           String       @id @default(uuid())
  documentType DocumentType @unique
  name         String?
  description  String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("compliance_requirements")
}

model AuditLog {
  id              String   @id @default(uuid())
  userId          String?
  clientProfileId String?
  documentId      String?
  action          String
  entityType      String
  entityId        String
  changes         Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())

  // Relations
  user          User?          @relation(fields: [userId], references: [id])
  clientProfile ClientProfile? @relation(fields: [clientProfileId], references: [id])
  document      Document?      @relation(fields: [documentId], references: [id])

  @@index([userId])
  @@index([clientProfileId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============ Aggregator: Invoice-To profile and per-client bookings ============

/// Invoice-To entity an AGGREGATOR user wants invoices raised against.
/// Saved once and auto-filled on every new client registration (still overridable per booking).
model AggregatorInvoiceProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  legalName         String
  constitution      String?
  gstin             String?
  pan               String?
  registeredAddress String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("aggregator_invoice_profiles")
}

/// One booking per aggregator-onboarded client registration (supports renewals/follow-ups via many-per-client).
/// Snapshots the Invoice-To fields at creation time so history is preserved even if the aggregator later edits their profile.
model AggregatorBooking {
  id                       String   @id @default(uuid())
  clientProfileId          String
  createdById              String // AGGREGATOR user
  // Booking details
  bookingReference         String?
  planType                 String?
  venueName                String?
  venueAddress             String?  @db.Text
  durationMonths           Int?
  amount                   Decimal? @db.Decimal(12, 2)
  currency                 String   @default("INR")
  gstApplicable            Boolean  @default(true)
  paymentTerms             String?  @db.Text
  signageTerms             String?  @db.Text
  // People
  clientContactName        String?
  pocName                  String?
  pocContact               String?
  // Signatory details (used to render the Leave & License agreement draft)
  clientFatherOrSpouseName String?
  clientPan                String?
  clientAadhaar            String?
  // Invoice-To snapshot (copied from AggregatorInvoiceProfile or override)
  invoiceLegalName         String?
  invoiceConstitution      String?
  invoiceGstin             String?
  invoicePan               String?
  invoiceRegisteredAddress String?  @db.Text
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  // Relations
  clientProfile ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  createdBy     User          @relation("BookingCreatedBy", fields: [createdById], references: [id])

  @@index([clientProfileId])
  @@index([createdById])
  @@index([bookingReference])
  @@map("aggregator_bookings")
}

// ============ Public Slot-Based Booking System ============

enum ResourceType {
  CONFERENCE_ROOM
  DISCUSSION_ROOM
  DAY_PASS_DESK
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum BookingSource {
  PUBLIC
  INTERNAL_COUPON
}

enum VisitorVisitStatus {
  CHECKED_IN
  CHECKED_OUT
}

model Location {
  id        String          @id @default(uuid())
  name      String
  address   String
  code      String?         @unique // Indiranagar_1 | Platinum | Kormangala_1
  area      String? // Indiranagar | Kormangala
  isActive  Boolean         @default(true)
  resources Resource[]
  vendors   Vendor[]
  clients   ClientProfile[]
  visits    VisitorVisit[]
  homeUsers User[]          @relation("UserHomeLocation")
  qrCodes   QrCode[]
  tickets   Ticket[]
  issueGroupRoutes IssueGroupRoute[]
  createdAt DateTime        @default(now())

  @@map("locations")
}

/// Staff-operated reception visitor log (face + signature + optional Aadhaar last-4).
model VisitorVisit {
  id        String             @id @default(uuid())
  name      String
  phone     String
  email     String?
  company   String?
  purpose   String
  hostName  String?
  hostEmail String?
  locationId String?
  location   Location?         @relation(fields: [locationId], references: [id])
  status     VisitorVisitStatus @default(CHECKED_IN)
  checkInAt  DateTime           @default(now())
  checkOutAt DateTime?

  // Aadhaar (never store full 12-digit number)
  aadhaarConsent        Boolean   @default(false)
  aadhaarConsentAt      DateTime?
  aadhaarConsentVersion String?
  aadhaarLast4          String?   @db.VarChar(4)

  // R2 object keys (private; serve via authenticated API)
  facePhotoKey    String
  signatureKey    String
  aadhaarPhotoKey String?

  checkedInById  String?
  checkedInBy    User?    @relation("VisitorCheckedInBy", fields: [checkedInById], references: [id])
  checkedOutById String?
  checkedOutBy   User?    @relation("VisitorCheckedOutBy", fields: [checkedOutById], references: [id])

  hostEmailSent   Boolean @default(false)
  hostEmailError  String?

  deletedAt  DateTime? // soft delete / retention purge marker
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([checkInAt])
  @@index([status, checkInAt])
  @@index([locationId])
  @@index([phone])
  @@map("visitor_visits")
}

model Resource {
  id         String   @id @default(uuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  type       ResourceType
  capacity   Int
  isActive   Boolean  @default(true)
  pricing    Pricing?
  bookings   Booking[]

  @@index([locationId])
  @@map("resources")
}

model TimeSlot {
  id        String    @id @default(uuid())
  startTime String
  endTime   String
  isFullDay Boolean   @default(false) // true for Day Pass full-day slot
  isActive  Boolean   @default(true)
  bookings  Booking[]

  @@map("time_slots")
}

model Pricing {
  id          String   @id @default(uuid())
  resourceId  String   @unique
  resource    Resource @relation(fields: [resourceId], references: [id])
  hourlyPrice Float?
  dayPrice    Float?
  updatedAt   DateTime @updatedAt

  @@map("pricing")
}

model Booking {
  id               String        @id @default(uuid())
  resourceId       String
  resource         Resource      @relation(fields: [resourceId], references: [id])
  date             DateTime      @db.Date
  timeSlotId       String?
  timeSlot         TimeSlot?     @relation(fields: [timeSlotId], references: [id])
  quantity         Int          @default(1)
  name             String
  email            String
  phone            String
  amountPaid       Float
  razorpayOrderId  String?
  paymentId        String?
  status           BookingStatus @default(PENDING)
  bookingSource    BookingSource @default(PUBLIC)
  couponCodeUsed   String?
  expiresAt        DateTime?
  createdAt        DateTime      @default(now())

  @@index([resourceId, date, timeSlotId, status])
  @@index([razorpayOrderId])
  @@index([status, expiresAt])
  @@map("bookings")
}

// ============ QR support tickets ============

enum TicketStatus {
  IN_PROGRESS
  CLOSED
}

enum TicketEventType {
  CREATED
  ASSIGNED
  COMMENTED
  STATUS_CHANGED
  EMAIL
  ATTACHMENT
}

enum RecipientKind {
  TO
  CC
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routes  IssueGroupRoute[]
  tickets Ticket[]

  @@map("departments")
}

model IssueGroup {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routes  IssueGroupRoute[]
  tickets Ticket[]

  @@map("issue_groups")
}

/// One route per issue group and location. locationKey is "GLOBAL" or the location id.
model IssueGroupRoute {
  id                String      @id @default(uuid())
  issueGroupId      String
  issueGroup        IssueGroup  @relation(fields: [issueGroupId], references: [id])
  locationKey       String
  locationId        String?
  location          Location?   @relation(fields: [locationId], references: [id])
  departmentId      String
  department        Department  @relation(fields: [departmentId], references: [id])
  defaultAssigneeId String?
  defaultAssignee   User?       @relation("RouteDefaultAssignee", fields: [defaultAssigneeId], references: [id])
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  recipients        IssueGroupRecipient[]

  @@unique([issueGroupId, locationKey])
  @@index([locationId])
  @@map("issue_group_routes")
}

model IssueGroupRecipient {
  id      String           @id @default(uuid())
  routeId String
  route   IssueGroupRoute  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  email   String
  kind    RecipientKind    @default(TO)

  @@index([routeId])
  @@map("issue_group_recipients")
}

model QrCode {
  id          String   @id @default(uuid())
  locationId  String
  location    Location @relation(fields: [locationId], references: [id])
  publicToken String   @unique
  label       String
  isActive    Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("QrCodeCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tickets     Ticket[]

  @@index([locationId])
  @@map("qr_codes")
}

model TicketSequence {
  year       Int @id
  lastNumber Int @default(0)

  @@map("ticket_sequences")
}

model Ticket {
  id                   String       @id @default(uuid())
  ticketNumber         String       @unique
  clientRequestId      String?      @unique
  customerName         String
  companyName          String
  customerEmail        String?
  customerPhone        String?
  locationId           String
  location             Location     @relation(fields: [locationId], references: [id])
  qrCodeId             String
  qrCode               QrCode       @relation(fields: [qrCodeId], references: [id])
  issueGroupId         String
  issueGroup           IssueGroup   @relation(fields: [issueGroupId], references: [id])
  issueDescription     String       @db.Text
  status               TicketStatus @default(IN_PROGRESS)
  assignedDepartmentId String?
  assignedDepartment   Department?  @relation(fields: [assignedDepartmentId], references: [id])
  assignedUserId       String?
  assignedUser         User?        @relation("TicketAssignee", fields: [assignedUserId], references: [id])
  resolutionNotes      String?      @db.Text
  closedAt             DateTime?
  closedById           String?
  closedBy             User?        @relation("TicketClosedBy", fields: [closedById], references: [id])
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  events        TicketEvent[]
  attachments   TicketAttachment[]
  notifications NotificationLog[]

  @@index([status, createdAt])
  @@index([locationId, status])
  @@index([issueGroupId])
  @@index([assignedDepartmentId])
  @@index([assignedUserId, status])
  @@index([companyName])
  @@index([createdAt])
  @@map("tickets")
}

model TicketEvent {
  id        String          @id @default(uuid())
  ticketId  String
  ticket    Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type      TicketEventType
  actorId   String?
  actor     User?           @relation("TicketEventActor", fields: [actorId], references: [id])
  details   Json?
  createdAt DateTime        @default(now())

  @@index([ticketId, createdAt])
  @@map("ticket_events")
}

model TicketAttachment {
  id           String   @id @default(uuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileKey      String
  fileName     String
  contentType  String
  sizeBytes    Int
  uploadedById String?
  uploadedBy   User?    @relation("TicketAttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_attachments")
}

model NotificationLog {
  id        String             @id @default(uuid())
  ticketId  String
  ticket    Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  kind      String
  subject   String
  html      String             @db.Text
  text      String             @db.Text
  toEmails  String[]
  ccEmails  String[]
  status    NotificationStatus @default(QUEUED)
  error     String?
  attempt   Int                @default(0)
  createdAt DateTime           @default(now())
  sentAt    DateTime?

  @@index([status, attempt])
  @@index([ticketId])
  @@map("notification_logs")
}
